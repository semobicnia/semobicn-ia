# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# Uma segunda análise completa aumenta o custo. Mantenha desativada e use a
# revisão humana para corrigir os dados extraídos do croqui.
OPENAI_AUTO_FALLBACK=false
OPENAI_FALLBACK_MODEL=gpt-5.6-sol
OPENAI_FALLBACK_CONFIDENCE=0.6

# Neon PostgreSQL
DATABASE_URL=

# Login com Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
INITIAL_ADMIN_EMAIL=semobicn.ia@gmail.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Limite do croqui recebido pela aplicação (10 MB)
MAX_PDF_SIZE_BYTES=10485760
